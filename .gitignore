# ============================================================
# AI Native Engineering Standard — .gitignore
# ============================================================
# 忽略规则按类别分组。每条规则都标注了原因。
# 如果你添加了新的工具或语言，请在本文件对应区域追加规则。
# ============================================================

# ----------------------------------------------------------
# 操作系统文件
# ----------------------------------------------------------
.DS_Store          # macOS Finder 元数据
Thumbs.db          # Windows 缩略图缓存
ehthumbs.db        # Windows 缩略图数据库
Desktop.ini        # Windows 文件夹配置

# ----------------------------------------------------------
# 编辑器与 IDE
# ----------------------------------------------------------
.vscode/           # VS Code 工作区配置（团队共享的放 .vscode/ 内单独提交）
.idea/             # JetBrains IDE 配置
*.swp              # Vim 交换文件
*.swo              # Vim 交换文件
*~                 # Vim/Emacs 备份文件
.history/          # 本地 shell 历史插件目录

# ----------------------------------------------------------
# 环境变量文件
# ----------------------------------------------------------
.env               # 默认环境变量（含密钥，绝不能提交）
.env.*             # 特定环境的环境变量
!.env.example      # 示例环境变量（不含密钥，允许提交）

# ----------------------------------------------------------
# 依赖目录
# ----------------------------------------------------------
node_modules/      # Node.js 依赖
__pycache__/       # Python 字节码缓存
*.pyc              # Python 编译文件
.venv/             # Python 虚拟环境
venv/              # Python 虚拟环境
vendor/            # PHP/Go vendor 目录（视项目决定是否忽略）
.gradle/           # Gradle 缓存
target/            # Rust/Java 构建输出

# ----------------------------------------------------------
# 构建产物
# ----------------------------------------------------------
dist/              # 通用构建输出
build/             # 通用构建输出
.next/             # Next.js 构建
.nuxt/             # Nuxt.js 构建
out/               # 通用输出目录
*.o                # C/C++ 目标文件
*.so               # 共享库
*.dylib            # macOS 动态库
*.dll              # Windows 动态库
*.exe              # Windows 可执行文件

# ----------------------------------------------------------
# 日志文件
# ----------------------------------------------------------
*.log              # 日志文件
logs/              # 日志目录
npm-debug.log*     # npm 调试日志
yarn-debug.log*    # Yarn 调试日志
yarn-error.log*    # Yarn 错误日志

# ----------------------------------------------------------
# 测试覆盖率
# ----------------------------------------------------------
coverage/          # 测试覆盖率报告
.nyc_output/       # NYC 覆盖率中间文件
.coverage          # Python 覆盖率
htmlcov/           # Python 覆盖率 HTML

# ----------------------------------------------------------
# 缓存与临时文件
# ----------------------------------------------------------
.cache/            # 通用缓存目录
*.tmp              # 临时文件
*.temp             # 临时文件
.turbo/            # Turborepo 缓存
.eslintcache       # ESLint 缓存
.tsbuildinfo       # TypeScript 增量构建信息

# ----------------------------------------------------------
# 密钥与凭证
# ----------------------------------------------------------
*.pem              # 私钥文件
*.key              # 密钥文件（公钥除外）
*.p12              # PKCS12 证书
secrets/           # 密钥目录
credentials.json   # GCP/AWS 凭证文件

# ----------------------------------------------------------
# AI 工具本地配置（仅忽略运行时配置，模板文件提交）
# ----------------------------------------------------------
.claude/           # Claude Code 本地配置
.claude.example/   # 如果需要 Claude Code 示例，使用此目录名

# ----------------------------------------------------------
# 其他
# ----------------------------------------------------------
.DS_Store?         # macOS 文件扩展属性
._*                # macOS 资源分支文件
